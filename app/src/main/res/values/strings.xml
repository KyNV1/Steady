    <string name="help_title">Help</string>
    <string name="help_search_hint">Search for help</string>
    <string name="help_frequently_asked">Frequently asked</string>
    <string name="help_no_results">No matching questions. Try another word or contact support.</string>
    <string name="help_faq_scan_question">How accurate is the AI meal scan?</string>
    <string name="help_faq_scan_answer">It\'s an estimate from a photo, meant for spotting trends rather than exact measurement. Portion size, cooking oils and sauces can throw it off, so check the result before you save it.</string>
    <string name="help_faq_medication_question">How do I switch medication type?</string>
    <string name="help_faq_medication_answer">Go to Profile → Medication &amp; dose, choose Injection or Pill / oral, then save. Log Dose updates to match — for example, it skips the injection-site step for oral medication.</string>
    <string name="help_faq_goals_question">Can I change my daily goals?</string>
    <string name="help_faq_goals_answer">Yes. Go to Profile → Daily goals to adjust protein, fiber and water at any time.</string>
    <string name="help_faq_subscription_question">How do I cancel my subscription?</string>
    <string name="help_faq_subscription_answer">Subscriptions are managed by Google Play. Open the Play Store → your profile picture → Payments &amp; subscriptions → Subscriptions → Steady → Cancel subscription.</string>
    <string name="help_faq_medical_question">Is Steady a substitute for medical advice?</string>
    <string name="help_faq_medical_answer">No. Steady helps you keep track, but it doesn\'t diagnose or treat anything. Talk to your doctor before changing your medication, and get medical help right away for severe symptoms.</string>
